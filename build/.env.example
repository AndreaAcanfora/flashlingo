# Copy this file to `.env` (which is gitignored) and fill in your key.
# Only the optional AI enrichment script (enrich.js) reads these — nothing else
# in the build or the app ever calls a paid API.

# Your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Model used for enrichment. VERIFY the current id in the Anthropic console
# before a real run — model ids change over time.
ANTHROPIC_MODEL=claude-haiku-4-5

# How many words to enrich in parallel.
ENRICH_CONCURRENCY=5

# Max output tokens per word.
ENRICH_MAX_TOKENS=400
